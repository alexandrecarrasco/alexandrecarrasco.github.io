{{- /* RSS feed for the home page (all posts), the Posts section, and each tag.
       Like Hugo's built-in feed, but the home feed lists posts only (not the About page),
       and the channel description says what the feed is about. */ -}}
{{- $pages := slice }}
{{- $description := site.Params.description }}
{{- if .IsHome }}
  {{- $pages = where site.RegularPages "Section" "blogs" }}
{{- else if .IsSection }}
  {{- $pages = .RegularPages }}
{{- else }}
  {{- $pages = .Pages }}
  {{- if eq .Kind "term" }}{{ $description = printf "Posts tagged #%s on %s." .Data.Term site.Title }}{{ end }}
{{- end }}
{{- $pages = $pages.ByDate.Reverse }}
{{- $limit := site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else if eq .Kind "term" }}#{{ .Data.Term }} · {{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    <copyright>© {{ now.Year }} {{ site.Params.author }}</copyright>
    {{- with $pages }}
    <lastBuildDate>{{ (index .ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | plainify | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
